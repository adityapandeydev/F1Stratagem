# F1Stratagem Environment Configuration

# PostgreSQL
DATABASE_URL=postgres://f1stratagem:f1stratagem@localhost:5432/f1stratagem?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=f1stratagem
DB_PASSWORD=f1stratagem
DB_NAME=f1stratagem

# Go API Server
API_PORT=8080
API_HOST=0.0.0.0
GIN_MODE=debug

# Python Worker
WORKER_PORT=8081
WORKER_HOST=0.0.0.0
WORKER_URL=http://localhost:8081

# FastF1 Cache
FASTF1_CACHE_DIR=./data/fastf1_cache

# Telemetry Storage
TELEMETRY_STORAGE_PATH=./data/telemetry
STORAGE_PROVIDER=local

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# Logging
LOG_LEVEL=debug
